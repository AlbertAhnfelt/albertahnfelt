# Copy to .dev.vars for local dev. In production each of these is a
# `wrangler secret put <NAME>` instead.

# Google OAuth app credentials (Google Cloud console > Credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated Google accounts allowed to connect. This is the "only me" gate.
ALLOWED_EMAILS=you@example.com

# Static bearer token for headless agents; bypasses OAuth, so treat it as
# equivalent to full vault access.
MCP_AUTH_TOKEN=dev-only-token

# Website browser login. In production these come from wrangler.jsonc `vars`
# (they are config, not secrets); uncomment here to point the flow at a local
# `astro dev` instead. Over plain http the session cookie is set without the
# Secure flag, which only works because localhost is a trusted origin — and
# http://localhost:4321/api/abbe/web/callback must also be an authorized
# redirect URI on the Google OAuth client for a local login to complete.
# SITE_ORIGIN=http://localhost:4321
# API_BASE_PATH=/api/abbe

# Google AI Studio key for the website chat (/web/chat)
GEMINI_API_KEY=

# Strava API application (https://www.strava.com/settings/api). Its
# "Authorization Callback Domain" must be the bare host of SITE_ORIGIN —
# www.albertahnfelt.com in production, localhost for a local run.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public usernames the read-only connectors pull from. In production these live
# in wrangler.jsonc `vars`; set them here to run the connectors locally.
# Leaving one empty switches that connector off rather than breaking the run.
# LETTERBOXD_USERNAME=
# CHESS_USERNAME=
