{
  "name": "abbe",
  "version": "0.1.0",
  "private": true,
  "description": "Abbe — personal second-brain remote MCP server on Cloudflare Workers + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.wrangler/smoke.mjs --log-level=error && node .wrangler/smoke.mjs",
    "live": "esbuild scripts/live-check.ts --bundle --platform=node --format=esm --outfile=.wrangler/live.mjs --log-level=error && node .wrangler/live.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/sdk": "1.23.0",
    "agents": "^0.2.0",
    "ai": "^7.0.36",
    "marked": "^18.0.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260721.1": true
  }
}
