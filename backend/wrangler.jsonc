{
  "name": "abbe",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "AbbeMCP", "class_name": "AbbeMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AbbeMCP"] }],
  "r2_buckets": [
    {
      "binding": "VAULT",
      "bucket_name": "abbe-vault",
      // `wrangler dev` otherwise binds a local simulation of this bucket, which
      // starts empty — so /vault renders whatever test objects happen to be in
      // .wrangler/state and reads as a vault with four notes in it. There is
      // nothing useful to develop against there: the point of the vault browser
      // and of Abbe's grounding is the actual notes.
      //
      // The cost is that the write tools — write_page, edit_page, move_page,
      // delete_page, and the nightly sweep's ai/log/ pages — now reach the real
      // vault from a local run. `wrangler dev --local` disables remote bindings
      // and gets the sandbox back when that matters.
      //
      // Deploys are unaffected: in production every binding is the real one.
      "remote": true
    }
  ],
  "d1_databases": [
    {
      // Website chat history: conversations, messages and the tool calls behind
      // each reply. Nothing the vault owns lives here — the vault is R2.
      "binding": "DB",
      "database_name": "abbe",
      "database_id": "90def425-c3be-4e17-a14e-2a32dca57006"
    }
  ],
  // Two daily jobs, told apart in `scheduled` by the expression that fired.
  //
  //   04:00 UTC — distil conversations that have gone quiet into ai/log/.
  //   05:00 UTC — pull Letterboxd and chess.com into data/.
  //
  // Nothing is being written at either hour, and a failed run has a whole day to
  // be noticed before the next one. An hour apart so a slow connector run can
  // never overlap the sweep; if the connectors cron is changed here it must be
  // changed in CONNECTORS_CRON in src/index.ts too, since the dispatch is a
  // string match on this text.
  "triggers": {
    "crons": ["0 4 * * *", "0 5 * * *"]
  },
  "kv_namespaces": [
    {
      // OAuth grants, tokens (hashed) and dynamically registered clients,
      // plus website sessions (hashed) under the `websession:` prefix.
      "binding": "OAUTH_KV",
      "id": "9be72ae12d3b4cf0a326b7ec0ed89895"
    }
  ],
  "vars": {
    // Where the browser reaches the /web/* endpoints: the website's origin plus
    // the path prefix its proxy rewrites onto this Worker. Not secrets, but they
    // must be config rather than request-derived — Google's redirect_uri and the
    // session cookie's Path are built from them, and behind the proxy the
    // inbound Host is the workers.dev name.
    "SITE_ORIGIN": "https://www.albertahnfelt.com",
    "API_BASE_PATH": "/api/abbe",
    // Which model answers on the website. Swap here, no code change.
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Whose public feeds the connectors read. Public usernames, not secrets —
    // and an empty one is how a connector is switched off: `check` reports it as
    // not configured rather than failing.
    "LETTERBOXD_USERNAME": "albertahnfelt",
    "CHESS_USERNAME": "garlicninja"
  },
  "observability": { "enabled": true }
  // Secrets (set via `wrangler secret put`, never here):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET — Google OAuth app credentials
  //   ALLOWED_EMAILS — comma-separated allowlist of Google accounts
  //   MCP_AUTH_TOKEN — static bearer token for headless agents (bypasses OAuth)
  //   GEMINI_API_KEY — Google AI Studio key, used only by /web/chat
}
