---
import Layout from '../layouts/Layout.astro'
import BackArrow from '../components/BackArrow.astro'
import MoonCorner from '../components/MoonCorner.astro'

// Placeholder for the Abbe interface. Everything below is static public HTML —
// signed-in state only decides which block is shown. When this page starts
// showing vault content it has to come from a cookie-authenticated Worker
// endpoint, never from anything baked in at build time.
---

<Layout title="Abbe">
  <main>
    <BackArrow href="/" label="Till startsidan" variant="corner" />

    <div class="content">
      <section class="abbe" data-abbe>
        <p data-state="loading">…</p>

        <div data-state="out" hidden>
          <p>Den här sidan är inte för allmänheten.</p>
          <p>
            <a class="login" href="/api/abbe/web/login?returnTo=/abbe">logga in</a>
          </p>
        </div>

        <div class="term" data-state="in" hidden>
          <h1>Abbe.</h1>

          <div data-log></div>

          <form class="line me" data-form>
            <span class="who">Albert</span>
            <div class="field">
              <div class="mirror"><span data-mirror></span><span class="cursor"></span></div>
              <textarea data-input rows="1" autocomplete="off" spellcheck="false"></textarea>
            </div>
          </form>
        </div>
      </section>
    </div>

    <MoonCorner variant="bottom-center" />
  </main>
</Layout>

<script>
  const show = (root: HTMLElement, state: 'loading' | 'out' | 'in') => {
    for (const block of root.querySelectorAll<HTMLElement>('[data-state]')) {
      block.hidden = block.dataset.state !== state
    }
  }

  type Turn = { role: 'user' | 'model'; text: string }

  const chat = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')
    const mirror = root.querySelector<HTMLElement>('[data-mirror]')
    const log = root.querySelector<HTMLElement>('[data-log]')
    if (!form || !input || !mirror || !log) return

    // The Worker is stateless, so the page owns the conversation and posts it
    // whole each turn. In memory only — nothing is persisted anywhere.
    const history: Turn[] = []
    let pending = false

    const say = (role: 'me' | 'abbe', text: string) => {
      const line = document.createElement('div')
      // Role lives on the row, not the label: it colours the whole line.
      line.className = `line ${role}`

      const who = document.createElement('span')
      who.className = 'who'
      who.textContent = role === 'me' ? 'Albert' : 'Abbe'

      const body = document.createElement('span')
      // textContent, never innerHTML: replies will eventually carry vault text.
      body.textContent = text

      line.append(who, body)
      log.append(line)
      form.scrollIntoView({ block: 'nearest' })
      // Returned so a pending row can be rewritten in place once it answers.
      return body
    }

    // The textarea's own text is transparent; this mirror is what you actually
    // read, and it carries the block cursor. Both share one grid cell, so the
    // textarea inherits the mirror's height and grows on its own.
    const sync = () => {
      mirror.textContent = input.value
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      const text = input.value.trim()
      if (!text || pending) return

      say('me', text)
      history.push({ role: 'user', text })
      input.value = ''
      sync()

      pending = true
      const row = say('abbe', '(thinking)')

      try {
        // Same-origin, so the HttpOnly session cookie rides along and the
        // Worker re-checks it. The vault is only ever touched over there.
        const res = await fetch('/api/abbe/web/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        })
        if (!res.ok) throw new Error(String(res.status))

        const { reply } = (await res.json()) as { reply?: string }
        if (!reply) throw new Error('empty')

        // textContent, never innerHTML: this is vault text via a model.
        row.textContent = reply
        history.push({ role: 'model', text: reply })
      } catch {
        row.textContent = '(något gick fel)'
        // The exchange never happened, so keep it out of the context sent next.
        history.pop()
      } finally {
        pending = false
        form.scrollIntoView({ block: 'nearest' })
        input.focus()
      }
    })

    input.addEventListener('input', sync)
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault()
        form.requestSubmit()
      }
    })

    // Clicking dead space in the transcript drops you back on the prompt,
    // unless you were selecting text to copy.
    root.addEventListener('click', () => {
      if (!window.getSelection()?.toString()) input.focus()
    })

    sync()
    input.focus()
  }

  const resolve = async (root: HTMLElement) => {
    if (root.dataset.ready) return
    root.dataset.ready = '1'

    // Dev only, and dead-code-eliminated from the production bundle: lets the
    // chat shell be looked at without a working Google login locally. It shows
    // an empty UI — there is still no vault content on this page to leak.
    if (import.meta.env.DEV && new URLSearchParams(window.location.search).has('preview')) {
      show(root, 'in')
      chat(root)
      return
    }

    try {
      const res = await fetch('/api/abbe/web/me', { headers: { accept: 'application/json' } })
      if (!res.ok) return show(root, 'out')

      show(root, 'in')
      chat(root)
    } catch {
      show(root, 'out')
    }
  }

  const run = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-abbe]')) resolve(root)
  }

  run()
  document.addEventListener('astro:page-load', run)
</script>

<style>
  /* Flex column so the moon's `margin-top: auto` can push it to the bottom of
     a short page, and get pushed down by a long conversation instead. */
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .content {
    display: flex;
    justify-content: center;
    padding: 2rem 1.5rem 0;
  }

  .abbe {
    width: 100%;
    max-width: 36rem;
    margin-top: 4rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .content {
      padding: 3vh 1.5rem 0;
    }

    .abbe {
      margin-top: 6rem;
      font-size: 1.05rem;
    }
  }

  [data-state='out'] p {
    margin-bottom: 1.2rem;
  }

  [data-state='out'] p:last-child {
    margin-bottom: 0;
  }

  .login {
    text-shadow: 0.12rem 0 0 var(--black);
    transition: transform 0.15s ease, text-shadow 0.15s ease;
    display: inline-block;
  }

  .login:hover,
  .login.clicky-hover {
    text-shadow: 0 0 0 transparent;
    transform: translateX(0.4rem);
  }

  .term {
    --me: #e2614f;
    --abbe: #7fa6ff;
  }

  .term h1 {
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .term h1 {
      font-size: 3rem;
    }
  }

  /* Transcript rows are built with createElement, so they never receive
     Astro's data-astro-cid-* scope attribute and a plain `.line {}` rule
     silently misses them. :global() matches them; anchoring to .term (which
     is in the template, so it *is* scoped) keeps it from leaking. */
  .term :global(.line) {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 1.25rem;
    align-items: start;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 768px) {
    .term :global(.line) {
      grid-template-columns: 5.5rem 1fr;
      gap: 0 1.5rem;
      margin-bottom: 1.3rem;
    }
  }

  /* Only the name is coloured — the message itself stays white. */
  .term :global(.line.me .who) {
    color: var(--me);
  }

  .term :global(.line.abbe .who) {
    color: var(--abbe);
  }

  .term :global(.line > span:last-child) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Joan ships Regular only, so the browser synthesises this weight. */
  .term :global(.who) {
    font-weight: 700;
  }

  .field {
    display: grid;
  }

  .mirror,
  .field textarea {
    grid-area: 1 / 1;
    font: inherit;
    line-height: inherit;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .mirror {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .field textarea {
    width: 100%;
    resize: none;
    overflow: hidden;
    background: none;
    /* Both transparent: the mirror above is the visible text and the caret. */
    color: transparent;
    caret-color: transparent;
  }

  .field textarea:focus {
    outline: none;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--white);
    vertical-align: -0.15em;
    animation: blink 1.1s steps(1, end) infinite;
  }

  .field:not(:focus-within) .cursor {
    animation: none;
    opacity: 0.3;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
