---
import Layout from '../layouts/Layout.astro'
import BackArrow from '../components/BackArrow.astro'
import MoonCorner from '../components/MoonCorner.astro'
import NotFound from '../components/NotFound.astro'

// The Abbe interface. Everything below is static public HTML — signed-in state
// only decides which block is shown, and not one conversation, title or word of
// a transcript is baked in at build time. All of it arrives at runtime from a
// cookie-authenticated Worker endpoint.
//
// Anyone who is not signed in gets the site's ordinary 404 and nothing else: no
// notice, no login link, nothing that names Abbe. That is presentation only —
// every real check lives in the Worker, which re-validates the session cookie
// against the allowlist on every request. Signing in is done by going straight
// to /api/abbe/web/login?returnTo=/abbe.
//
// One page serves both a new conversation and an existing one; which is decided
// from location.pathname. /abbe/:id is rewritten here by vercel.json (and by the
// dev middleware in astro.config.mjs), because a conversation id cannot be
// prerendered — knowing them at build time would mean knowing the history.
---

<!-- Titled 404, not Abbe: the static HTML every visitor gets should read as the
     404 it will be for almost all of them. `authTitle` is the tab's other name,
     applied only once the session is believed to be real. -->
<Layout title="404" authTitle="Abbe">
  <div data-abbe>
    <!-- Both states ship in the HTML, and CSS shows exactly one, keyed off the
         flag Layout's head script stamps on <html> before the first paint.
         Neither is shown until that flag is set, so there is no frame with both
         and none where the page sits empty waiting on the network. -->
    <div data-state="out">
      <NotFound persist={false} />
    </div>

    <main data-state="in">
      <BackArrow href="/" label="Till startsidan" variant="corner" />

      <div class="shell">
        <!-- History. A sticky column beside the chat on a wide screen, a
             sideways-scrolling strip above it on a narrow one. Empty in the
             shipped HTML; filled from /web/chats once the session is real. -->
        <nav class="rail" aria-label="Konversationer">
          <button class="new" type="button" data-new>ny</button>
          <div class="rail-list" data-rail-list></div>
        </nav>

        <div class="content">
          <section class="abbe">
            <div class="term">
              <h1>Abbe.</h1>

              <!-- One dim system line: who is answering and how much history
                   there is. Filled once the session and the rail are known. -->
              <p class="boot" data-boot></p>

              <div data-log></div>

              <!-- The mirror is split around the caret rather than being one
                   span with a cursor stuck on the end, so the block sits where
                   typing will actually land. aria-hidden because it is a
                   duplicate of the textarea's own value. -->
              <form class="line me" data-form>
                <span class="who">Albert</span>
                <div class="field">
                  <div class="mirror" aria-hidden="true"><span data-before
                    ></span><span class="cursor" data-cursor></span><span
                    class="sel" data-sel></span><span data-after></span><span
                    class="ghost" data-ghost></span></div>
                  <textarea data-input rows="1" autocomplete="off" spellcheck="false"></textarea>
                </div>
              </form>

              <!-- Live state: the spinner, how long it has been going, and how
                   to stop it. Only present while a turn is in flight. -->
              <p class="bar" data-bar hidden></p>

              <!-- Failures belong here, not in the transcript: a line labelled
                   "Abbe" is something Abbe said, and the stream breaking is
                   not. Matches how /vault reports the same kind of trouble. -->
              <p class="status" data-status hidden></p>
            </div>
          </section>
        </div>
      </div>

      <MoonCorner variant="bottom-center" />
    </main>
  </div>
</Layout>

<script>
  /** A conversation as the sidebar knows it. No transcript. */
  type ChatSummary = { id: string; title: string; updated_at: number }

  /** One stored turn, as /web/chats/:id returns it. */
  type StoredMessage = {
    id: number
    role: 'user' | 'model'
    text: string
    created_at: number
    partial: boolean
  }

  /**
   * A tool call. The same shape arrives two ways — live on the chat stream and
   * stored on a transcript — which is why `message_id` is optional: live, the
   * reply it belongs to does not have an id yet.
   */
  type ToolEvent = {
    name: string
    detail: string
    ok: boolean
    ms: number | null
    message_id?: number | null
  }

  /** A vault page, as /web/vault/pages lists it. Used by /valv. */
  type VaultPage = { path: string; title: string; folder: string }

  const API = '/api/abbe/web'

  /** The shape the Worker mints. Anything else is not a conversation id. */
  const ID = /^[0-9a-f]{64}$/

  /**
   * Which model is answering, from /web/me. The page paints optimistically from
   * the hint cookie, so the chat is wired up before this is known — hence the
   * callback: whoever is showing the system line gets told to redraw it.
   */
  let model: string | null = null
  let redrawBoot: (() => void) | null = null

  /**
   * Which block is real. One flag on <html>, set here and by Layout's head
   * script, with CSS doing the showing — so the same switch works before this
   * bundle has even been fetched.
   */
  const show = (state: 'out' | 'in') => {
    document.documentElement.dataset.session = state
  }

  /**
   * The page ships as a 404, title included, so there is no moment where the tab
   * says "Abbe" to someone who is not signed in. Both names come from the head
   * (see Layout.astro), which is the only place either is spelled out.
   */
  const title = (state: 'out' | 'in') => {
    const root = document.documentElement
    const meta = document.querySelector<HTMLMetaElement>('meta[name="auth-title"]')

    if (state === 'in') {
      if (!meta || document.title === meta.content) return
      root.dataset.publicTitle = document.title
      document.title = meta.content
    } else if (root.dataset.publicTitle) {
      document.title = root.dataset.publicTitle
    }
  }

  /** The conversation this URL asks for, or null for a fresh one. */
  const idFromUrl = (): string | null => {
    const rest = window.location.pathname.replace(/^\/abbe\/?/, '')
    return ID.test(rest) ? rest : null
  }

  const chat = (root: HTMLElement) => {
    // signedIn() runs twice on a normal load — once on the hint, once when
    // /web/me confirms it — and the second pass must not double the listeners.
    if (root.dataset.chat) return
    root.dataset.chat = '1'

    const term = root.querySelector<HTMLElement>('.term')
    const form = root.querySelector<HTMLFormElement>('[data-form]')
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')
    const before = root.querySelector<HTMLElement>('[data-before]')
    const selected = root.querySelector<HTMLElement>('[data-sel]')
    const after = root.querySelector<HTMLElement>('[data-after]')
    const ghost = root.querySelector<HTMLElement>('[data-ghost]')
    const cursor = root.querySelector<HTMLElement>('[data-cursor]')
    const log = root.querySelector<HTMLElement>('[data-log]')
    const statusEl = root.querySelector<HTMLElement>('[data-status]')
    const barEl = root.querySelector<HTMLElement>('[data-bar]')
    const bootEl = root.querySelector<HTMLElement>('[data-boot]')
    const railList = root.querySelector<HTMLElement>('[data-rail-list]')
    const newButton = root.querySelector<HTMLButtonElement>('[data-new]')
    if (!term || !form || !input || !before || !selected || !after || !ghost) return
    if (!cursor || !log || !statusEl || !barEl || !bootEl || !railList || !newButton) return

    // The Worker owns the transcript; this holds only what is on screen. The
    // conversation is identified by its id and nothing is replayed from here.
    let chats: ChatSummary[] = []
    let currentId: string | null = null
    let pending = false

    /**
     * Interrupting a turn. The controller only stops *this* side reading: the
     * Worker runs the turn under waitUntil and stores whatever it generated, so
     * an abort leaves the screen and the stored transcript agreeing.
     */
    let controller: AbortController | null = null
    let aborted = false

    /** Recall, ↑/↓. Seeded from the transcript, so it survives a reload. */
    let past: string[] = []
    let pastAt: number | null = null
    let draft = ''

    /** Whether the tool trace is shown. A class on .term does the showing. */
    let verbose = false

    /** Titles for /valv, fetched once and only if asked for. */
    let vaultPages: VaultPage[] | null = null

    /* ---------------------------------------------------------- transcript */

    /** Trouble, said in the page's own voice rather than attributed to Abbe. */
    const status = (message: string | null) => {
      statusEl.textContent = message ?? ''
      statusEl.hidden = !message
    }

    const clock = (at: number) =>
      new Date(at).toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' })

    const say = (
      role: 'me' | 'abbe',
      text: string,
      opts: { partial?: boolean; at?: number } = {},
    ) => {
      const line = document.createElement('div')
      // Role lives on the row, not the label: it colours the whole line.
      line.className = `line ${role}${opts.partial ? ' partial' : ''}`

      const who = document.createElement('span')
      who.className = 'who'
      who.textContent = role === 'me' ? 'Albert' : 'Abbe'

      // Under the name rather than in a column of its own: it buys the density a
      // transcript wants without taking width from the message on a phone.
      const at = document.createElement('span')
      at.className = 'at'
      at.textContent = clock(opts.at ?? Date.now())
      who.append(at)

      const body = document.createElement('span')
      // textContent, never innerHTML: replies carry vault text via a model.
      body.textContent = text

      line.append(who, body)
      log.append(line)
      form.scrollIntoView({ block: 'nearest' })
      // Both, because a streaming row is rewritten through `body` while the
      // class that marks it lives on `line`.
      return { line, body }
    }

    /**
     * One tool call, as a dim single line. Always put in the DOM; whether it is
     * visible is `.term.verbose`, so /verbose costs no re-render and reveals the
     * calls behind replies that are already on screen.
     *
     * `name` and `detail` are model-generated — textContent, as everywhere.
     */
    const trace = (event: ToolEvent, mark?: Element | null) => {
      const row = document.createElement('div')
      row.className = `trace${event.ok ? '' : ' failed'}`

      const name = document.createElement('span')
      name.className = 'tname'
      name.textContent = event.name

      const detail = document.createElement('span')
      detail.className = 'tdetail'
      detail.textContent = event.detail

      const took = document.createElement('span')
      took.className = 'tms'
      took.textContent = event.ms === null ? '' : `${event.ms} ms`

      row.append(name, detail, took)
      // Tools ran before the answer they produced, so they are printed above it.
      if (mark) log.insertBefore(row, mark)
      else log.append(row)
      return row
    }

    /**
     * The terminal talking about itself: help, search results, notices. A pair
     * per row, laid out as a grid — the site's face is proportional, so columns
     * cannot be faked with padded spaces.
     */
    const sys = (heading: string, rows: [string, string | Node][]) => {
      const block = document.createElement('div')
      block.className = 'sys'

      const title = document.createElement('div')
      title.className = 'sysh'
      title.textContent = heading
      block.append(title)

      for (const [key, value] of rows) {
        const k = document.createElement('span')
        k.className = 'sysk'
        k.textContent = key

        const v = document.createElement('span')
        v.className = 'sysv'
        if (typeof value === 'string') v.textContent = value
        else v.append(value)

        block.append(k, v)
      }

      log.append(block)
      form.scrollIntoView({ block: 'nearest' })
      return block
    }

    /* --------------------------------------------------------- live status */

    /** Braille, because it turns in place instead of jittering the line width. */
    const FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']

    /** Past this many seconds the spinner warms, to say it is still working. */
    const SLOW_AFTER_S = 10

    let spinner: number | null = null

    const bar = (text: string | null) => {
      barEl.textContent = text ?? ''
      barEl.hidden = !text
    }

    const startSpinner = () => {
      const began = Date.now()
      let frame = 0

      const tick = () => {
        const seconds = Math.floor((Date.now() - began) / 1000)
        barEl.classList.toggle('slow', seconds >= SLOW_AFTER_S)
        bar(`${FRAMES[frame++ % FRAMES.length]}  tänker… ${seconds}s  ·  esc avbryter`)
      }

      tick()
      spinner = window.setInterval(tick, 120)
    }

    const stopSpinner = () => {
      if (spinner !== null) window.clearInterval(spinner)
      spinner = null
      barEl.classList.remove('slow')
      bar(null)
    }

    /** The system line under the heading. Redrawn when /web/me names the model. */
    const boot = () => {
      const parts = ['abbe']
      if (model) parts.push(model)
      parts.push(chats.length === 1 ? '1 konversation' : `${chats.length} konversationer`)
      if (verbose) parts.push('verbose')
      bootEl.textContent = parts.join('   ·   ')
    }

    redrawBoot = boot

    /* -------------------------------------------------------------- history */

    const renderRail = () => {
      railList.replaceChildren()
      for (const item of chats) {
        const link = document.createElement('a')
        link.className = 'entry'
        link.href = `/abbe/${item.id}`
        // textContent, never innerHTML: a title is the first thing said, echoed.
        link.textContent = item.title
        // The date lives here rather than on screen — the list is already in
        // recency order, and this keeps the rail to one line per conversation.
        link.title = new Date(item.updated_at).toLocaleString('sv-SE')
        if (item.id === currentId) link.setAttribute('aria-current', 'page')
        railList.append(link)
      }
    }

    const loadChats = async () => {
      try {
        const res = await fetch(`${API}/chats`, { headers: { accept: 'application/json' } })
        if (!res.ok) return
        chats = ((await res.json()) as { chats: ChatSummary[] }).chats
        renderRail()
        boot()
      } catch {
        // A rail that failed to load is a rail that is empty. The chat itself
        // does not depend on it, so there is nothing to say about this.
      }
    }

    /** Move the conversation just spoken in to the front, where it belongs. */
    const touch = (id: string) => {
      const at = chats.findIndex((item) => item.id === id)
      if (at === -1) return
      const [item] = chats.splice(at, 1)
      chats.unshift({ ...item, updated_at: Date.now() })
      renderRail()
    }

    /* ------------------------------------------------------------- routing */

    const openChat = async (id: string) => {
      try {
        const res = await fetch(`${API}/chats/${id}`, { headers: { accept: 'application/json' } })
        if (!res.ok) throw new Error(String(res.status))
        const { messages, tools } = (await res.json()) as {
          messages: StoredMessage[]
          tools?: ToolEvent[]
        }

        // Grouped by the reply each round of calls led to, so the trace can be
        // printed where it happened rather than in a heap at the end.
        const byMessage = new Map<number, ToolEvent[]>()
        for (const event of tools ?? []) {
          if (event.message_id == null) continue
          const list = byMessage.get(event.message_id)
          if (list) list.push(event)
          else byMessage.set(event.message_id, [event])
        }

        log.replaceChildren()
        past = []
        pastAt = null

        for (const message of messages) {
          for (const event of byMessage.get(message.id) ?? []) trace(event)
          say(message.role === 'user' ? 'me' : 'abbe', message.text, {
            partial: message.partial,
            at: message.created_at,
          })
          // What ↑ walks back through. Seeded from the transcript, so recall
          // works on a conversation this tab has never spoken in.
          if (message.role === 'user') past.push(message.text)
        }
      } catch {
        log.replaceChildren()
        status('kunde inte läsa konversationen.')
      }
    }

    const route = async () => {
      const id = idFromUrl()
      // Already showing this one. Matters because every reply replaces the URL,
      // and re-reading the transcript we just wrote would be a visible flicker.
      if (id === currentId) return

      currentId = id
      log.replaceChildren()
      status(null)
      // A fresh conversation has nothing to recall, and carrying the previous
      // one's messages over would put words in this one's history.
      past = []
      pastAt = null
      renderRail()
      if (id) await openChat(id)
      form.scrollIntoView({ block: 'nearest' })
    }

    const startNew = () => {
      if (currentId === null) return input.focus()
      window.history.pushState({}, '', '/abbe')
      void route()
      input.focus()
    }

    /* ------------------------------------------------------------ commands */

    const clearScreen = () => {
      log.replaceChildren()
      status(null)
      form.scrollIntoView({ block: 'nearest' })
    }

    const setVerbose = (on: boolean) => {
      verbose = on
      term.classList.toggle('verbose', on)
      boot()
      try {
        window.localStorage.setItem('abbe:verbose', on ? '1' : '0')
      } catch {
        // Private browsing, or storage full. The toggle still works for this
        // page; it just will not be remembered.
      }
    }

    /** Titles only, and only fetched the first time /valv is used. */
    const vaultSearch = async (query: string) => {
      const q = query.trim().toLowerCase()
      if (!q) {
        sys('valv', [['/valv', 'ange en sökfras, t.ex. /valv loggning']])
        return
      }

      if (!vaultPages) {
        try {
          const res = await fetch(`${API}/vault/pages`, {
            headers: { accept: 'application/json' },
          })
          if (!res.ok) throw new Error(String(res.status))
          vaultPages = ((await res.json()) as { pages: VaultPage[] }).pages
        } catch {
          status('kunde inte läsa valvet.')
          return
        }
      }

      const hits = vaultPages
        .filter((p) => p.title.toLowerCase().includes(q) || p.folder.toLowerCase().includes(q))
        .slice(0, 12)

      if (hits.length === 0) {
        sys(`valv · ${q}`, [['', 'inga träffar.']])
        return
      }

      sys(`valv · ${hits.length} träffar`, [
        ...hits.map((page): [string, Node] => {
          const link = document.createElement('a')
          link.href = `/vault/${page.path.split('/').map(encodeURIComponent).join('/')}`
          // textContent, never innerHTML: a title is a vault filename.
          link.textContent = page.title
          return [page.folder || '/', link]
        }),
      ])
    }

    type Command = {
      name: string
      /** Shown as a ghost once the name is complete, e.g. `/valv <fras>`. */
      arg?: string
      aliases?: string[]
      help: string
      run: (rest: string) => void | Promise<void>
    }

    const COMMANDS: Command[] = [
      { name: '/ny', aliases: ['/new'], help: 'börja en ny konversation', run: () => startNew() },
      {
        name: '/rensa',
        aliases: ['/clear'],
        help: 'rensa rutan — ctrl+l gör samma sak',
        run: () => clearScreen(),
      },
      { name: '/valv', arg: '<fras>', help: 'sök titlar i valvet', run: (rest) => vaultSearch(rest) },
      {
        name: '/verbose',
        help: 'visa eller göm verktygsanrop',
        run: () => setVerbose(!verbose),
      },
      { name: '/hjälp', aliases: ['/help', '/?'], help: 'den här listan', run: () => showHelp() },
    ]

    function showHelp() {
      sys('kommandon', [
        ...COMMANDS.map((c): [string, string] => [
          c.arg ? `${c.name} ${c.arg}` : c.name,
          c.help,
        ]),
      ])
      sys('tangenter', [
        ['↑ ↓', 'tidigare meddelanden'],
        ['tab', 'fyll i kommandot'],
        ['esc', 'avbryt ett svar som skrivs'],
        ['ctrl+l', 'rensa rutan'],
        ['skift+enter', 'ny rad'],
      ])
    }

    /** The command a line names, if any. Matched on the first word only. */
    const commandFor = (text: string): { command: Command; rest: string } | null => {
      const space = text.indexOf(' ')
      const head = (space === -1 ? text : text.slice(0, space)).toLowerCase()
      const rest = space === -1 ? '' : text.slice(space + 1)
      const command = COMMANDS.find((c) => c.name === head || c.aliases?.includes(head))
      return command ? { command, rest } : null
    }

    const runCommand = async (text: string) => {
      const found = commandFor(text)
      if (!found) {
        status(`okänt kommando: ${text.split(' ')[0]} — /hjälp visar listan.`)
        return
      }
      status(null)
      await found.command.run(found.rest)
    }

    /* --------------------------------------------------------------- input */

    // The textarea's own text is transparent; this mirror is what you actually
    // read, and it carries the block cursor. Both share one grid cell, so the
    // textarea inherits the mirror's height and grows on its own.
    //
    // The mirror is drawn in three pieces around the caret. It used to be one
    // span with the cursor parked after it, which put the block at the end of
    // the value no matter where the caret really was — so tapping into the
    // middle of a line left nothing on screen saying where the next character
    // would go, and you had to type one to find out.
    const sync = () => {
      const value = input.value
      // Both are nullable on a textarea per the DOM spec, though in practice
      // only for input types that do not support selection.
      const start = input.selectionStart ?? value.length
      const end = input.selectionEnd ?? start

      before.textContent = value.slice(0, start)
      selected.textContent = value.slice(start, end)
      after.textContent = value.slice(end)

      // With a range there is no single insertion point to mark, and the
      // highlight already says what is going to be replaced.
      cursor.hidden = start !== end

      ghost.textContent = completion(value, start === end && end === value.length)
    }

    /**
     * The dim rest of the command being typed, or ''.
     *
     * Only with the caret at the very end — a suggestion trailing text you are
     * editing in the middle of is noise — and only when exactly one command
     * matches, because a ghost that guesses between two is worse than none.
     * Once the name is complete it becomes the argument hint instead.
     */
    const completion = (value: string, atEnd: boolean): string => {
      if (!atEnd || !value.startsWith('/')) return ''

      const exact = COMMANDS.find((c) => c.name === value.toLowerCase())
      if (exact) return exact.arg ? ` ${exact.arg}` : ''

      // A space means the name is settled and we are into arguments.
      if (value.includes(' ')) return ''

      const matches = COMMANDS.filter((c) => c.name.startsWith(value.toLowerCase()))
      return matches.length === 1 ? matches[0].name.slice(value.length) : ''
    }

    /** Replace the whole line and put the caret at the end, as recall does. */
    const setValue = (value: string) => {
      input.value = value
      input.setSelectionRange(value.length, value.length)
      sync()
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      const text = input.value.trim()
      if (!text || pending) return

      // Recall holds everything typed at this prompt, commands included — they
      // are the lines most worth getting back without retyping.
      past.push(text)
      pastAt = null
      draft = ''

      // A command never reaches the Worker and never becomes a turn: it is the
      // terminal talking to itself.
      if (text.startsWith('/')) {
        input.value = ''
        sync()
        await runCommand(text)
        return
      }

      say('me', text)
      input.value = ''
      sync()
      status(null)

      // readOnly rather than disabled: disabling a focused textarea hands focus
      // back to the document, and since the caret is drawn from this element's
      // selection, losing it would take the cursor off screen mid-turn.
      pending = true
      input.readOnly = true
      form.classList.add('busy')
      aborted = false
      controller = new AbortController()
      startSpinner()

      // Empty, with the streaming class doing the talking — a blinking block
      // where the answer will appear, rather than the word "(thinking)" sitting
      // there as though Abbe had said it.
      const { line, body: row } = say('abbe', '')
      line.classList.add('streaming')
      // Captured now: the reply belongs to the conversation that was open when
      // it was asked for, even if something navigates while it streams.
      const asked = currentId

      try {
        // Same-origin, so the HttpOnly session cookie rides along and the
        // Worker re-checks it. The vault is only ever touched over there, and
        // the transcript is read from D1 there too — this posts one message.
        const res = await fetch(`${API}/chat`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ conversation_id: asked, text }),
          signal: controller.signal,
        })
        if (!res.ok || !res.body) throw new Error(String(res.status))

        // NDJSON: one JSON object per line, so a line split across two network
        // chunks has to be held back until its newline arrives.
        const reader = res.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ''
        let reply = ''

        for (;;) {
          const { done, value } = await reader.read()
          if (done) break
          buffer += decoder.decode(value, { stream: true })

          const lines = buffer.split('\n')
          buffer = lines.pop() ?? ''

          // `chunk`, not `line` — the reply's own row is named that in this
          // scope, and shadowing it here is how you edit the wrong thing.
          for (const chunk of lines) {
            if (!chunk.trim()) continue
            const event = JSON.parse(chunk) as {
              conversation?: { id: string; title: string }
              tool?: ToolEvent
              delta?: string
              done?: boolean
              error?: string
            }
            if (event.error) throw new Error(event.error)

            // Printed above the reply, where it happened. Hidden unless
            // /verbose, but written into the DOM either way so turning it on
            // reveals the calls behind answers already on screen.
            if (event.tool) {
              trace(event.tool, line)
              continue
            }

            // First line of every stream. On a fresh conversation this is how
            // the page learns the id the Worker minted, and the URL becomes
            // shareable without a navigation.
            if (event.conversation) {
              if (!currentId) {
                currentId = event.conversation.id
                window.history.replaceState({}, '', `/abbe/${currentId}`)
                chats.unshift({ ...event.conversation, updated_at: Date.now() })
                renderRail()
              }
              continue
            }

            if (event.delta === undefined) continue
            reply += event.delta
            // textContent, never innerHTML: this is vault text via a model.
            row.textContent = reply
            form.scrollIntoView({ block: 'nearest' })
          }
        }

        if (!reply) throw new Error('empty')
        if (asked) touch(asked)
      } catch {
        // Whatever did arrive is kept and marked, because the Worker stores the
        // fragment too — overwriting it here would leave the page saying
        // something different from what a reload will show. A turn that
        // produced nothing at all leaves no Abbe line to explain itself.
        if (row.textContent) line.classList.add('partial')
        else line.remove()

        // An interruption is not a failure. The Worker keeps going under
        // waitUntil and stores what it made, so this says what happened rather
        // than blaming something — and a reload will show the same fragment.
        status(aborted ? 'avbruten.' : 'något gick fel.')
        // Albert's own message is stored either way — the Worker writes it
        // before asking the model — so there is nothing to take back here.
      } finally {
        pending = false
        controller = null
        input.readOnly = false
        form.classList.remove('busy')
        line.classList.remove('streaming')
        stopSpinner()
        form.scrollIntoView({ block: 'nearest' })
        input.focus()
      }
    })

    // The caret moves for more reasons than typing: arrow keys, a tap into the
    // middle of a line, a drag, undo, autocorrect. `selectionchange` covers all
    // of them on current browsers; the rest are belt for older ones and cost a
    // repaint of two spans.
    for (const type of ['input', 'keyup', 'click', 'pointerup', 'select', 'focus'] as const) {
      input.addEventListener(type, sync)
    }
    document.addEventListener('selectionchange', () => {
      if (document.activeElement === input) sync()
    })

    input.addEventListener('keydown', (event) => {
      // First, because it is the one key that has to work while the prompt is
      // read-only and everything below is refusing input.
      if (event.key === 'Escape') {
        if (!controller) return
        event.preventDefault()
        aborted = true
        controller.abort()
        return
      }

      if (event.key.toLowerCase() === 'l' && (event.ctrlKey || event.metaKey)) {
        event.preventDefault()
        clearScreen()
        return
      }

      if (event.key === 'Tab' && ghost.textContent) {
        event.preventDefault()
        // The argument hint is a label, not text to insert — completing `/valv`
        // should leave you ready to type the phrase, not the word "<fras>".
        const rest = ghost.textContent.trim().startsWith('<') ? ' ' : ghost.textContent
        setValue(input.value + rest)
        return
      }

      // Recall only from the edge of the text, so arrows still move within a
      // message that happens to span several lines.
      if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
        const caret = input.selectionStart ?? 0
        const up = event.key === 'ArrowUp'
        const atEdge = up
          ? !input.value.slice(0, caret).includes('\n')
          : !input.value.slice(input.selectionEnd ?? caret).includes('\n')
        if (!atEdge) return

        if (up) {
          if (past.length === 0) return
          event.preventDefault()
          // Stepping in for the first time: keep whatever was half-typed, so
          // coming back down returns it rather than an empty line.
          if (pastAt === null) {
            draft = input.value
            pastAt = past.length
          }
          pastAt = Math.max(0, pastAt - 1)
          setValue(past[pastAt])
          return
        }

        if (pastAt === null) return
        event.preventDefault()
        pastAt += 1
        if (pastAt >= past.length) {
          pastAt = null
          setValue(draft)
        } else {
          setValue(past[pastAt])
        }
        return
      }

      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault()
        form.requestSubmit()
      }
    })

    newButton.addEventListener('click', startNew)

    // Rail links are handled here rather than by the browser: a full navigation
    // would re-run auth and re-fetch the whole list to move between two
    // conversations this page already has.
    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null
      const link = target?.closest?.('a')

      if (link && link.getAttribute('href')?.startsWith('/abbe/')) {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
        event.preventDefault()
        if (link.getAttribute('href') === window.location.pathname) return
        window.history.pushState({}, '', link.getAttribute('href')!)
        void route()
        return
      }

      // Clicking dead space in the transcript drops you back on the prompt,
      // unless you were selecting text to copy or aiming at a control.
      if (link || target?.closest?.('button')) return
      if (!window.getSelection()?.toString()) input.focus()
    })

    window.addEventListener('popstate', () => void route())

    // Remembered across loads, because it is a preference about how much you
    // want to see rather than state belonging to a conversation.
    try {
      setVerbose(window.localStorage.getItem('abbe:verbose') === '1')
    } catch {
      setVerbose(false)
    }

    sync()
    boot()
    void route()
    void loadChats()
    input.focus()
  }

  const signedIn = (root: HTMLElement) => {
    show('in')
    title('in')
    chat(root)
  }

  const signedOut = () => {
    show('out')
    title('out')
  }

  const resolve = async (root: HTMLElement) => {
    if (root.dataset.ready) return
    root.dataset.ready = '1'

    // Dev only, and dead-code-eliminated from the production bundle: lets the
    // chat shell be looked at without a working Google login locally. It shows
    // an empty UI — there is still no vault content on this page to leak.
    if (import.meta.env.DEV && new URLSearchParams(window.location.search).has('preview')) {
      signedIn(root)
      return
    }

    // The head script has already painted from the hint cookie. Taking it at its
    // word here too is what makes the page usable immediately: the prompt is
    // wired up and focused now, rather than a round trip from now.
    if (document.documentElement.dataset.session === 'in') signedIn(root)

    try {
      // The authority, and the only thing that gets to be the last word. The
      // Worker deletes a stale hint on its way out of this call, so a session
      // that has been revoked cannot keep painting itself back in.
      const res = await fetch(`${API}/me`, { headers: { accept: 'application/json' } })
      if (!res.ok) return signedOut()

      // Which model is answering. Known only now, whereas the chat was wired up
      // from the hint cookie a moment ago — so the system line is told to
      // redraw rather than being built with a gap in it.
      const me = (await res.json()) as { model?: string }
      if (typeof me.model === 'string') model = me.model

      signedIn(root)
      redrawBoot?.()
    } catch {
      // Offline, or the Worker is down. Whatever is on screen stays: a dropped
      // request is not evidence about the session, and there is nothing on this
      // page to protect — the chat endpoint does its own checking, and will
      // fail the same way this did.
    }
  }

  const run = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-abbe]')) resolve(root)
  }

  run()
  document.addEventListener('astro:page-load', run)
</script>

<style>
  /* Neither state shows until <html> has been told which one is real, so a
     browser with JavaScript off sees the same nothing it saw when both blocks
     were `hidden`. :global() on the <html> half because Astro's scoping would
     otherwise demand this component's attribute on the root element, which
     never has it. */
  [data-state] {
    display: none;
  }

  :global(html[data-session='out']) [data-state='out'] {
    display: block;
  }

  /* Flex column so the moon's `margin-top: auto` can push it to the bottom of
     a short page, and get pushed down by a long conversation instead. */
  :global(html[data-session='in']) [data-state='in'] {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Narrow first: history above the chat, chat below it. */
  .shell {
    display: flex;
    flex-direction: column;
  }

  .content {
    display: flex;
    justify-content: center;
    padding: 2rem 1.5rem 0;
  }

  .abbe {
    width: 100%;
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ---------------------------------------------------------------- history */

  /* On a narrow screen this scrolls sideways instead of down: the conversations
     are one line each, and a vertical list of them would push the prompt off
     the screen. The top margin is what clears the corner back arrow. */
  .rail {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-top: 4rem;
    padding: 0 1.5rem 0.75rem;
    border-bottom: 1px solid rgba(239, 237, 234, 0.12);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* A `start`-aligned snap target aligns to the scroll port's edge, which on
       load meant snapping the first item flush to the screen and scrolling the
       rail's own left padding out of view. This insets the snap edge instead, so
       the strip starts where the rest of the page starts. */
    scroll-padding-inline-start: 1.5rem;
    /* The strip is short and the entries are obviously draggable; a scrollbar
       across them costs more than it explains. */
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  /* `contents` so the entries become children of .rail itself and take part in
     its row directly — one scroll container instead of two nested ones. */
  .rail-list {
    display: contents;
  }

  /* Rail entries are built with createElement, so they never receive Astro's
     data-astro-cid-* attribute and the `.rail .entry {}` rules that used to
     live here matched nothing whatsoever. Unstyled, each title was a plain
     inline <a>, so a column of conversations rendered as one run-together
     paragraph of every title in sequence. :global() matches them; anchoring to
     .rail — which is in the template, so it *is* scoped — contains it. */
  .rail :global(.entry),
  .new {
    white-space: nowrap;
    scroll-snap-align: start;
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }

  .rail :global(.entry:hover),
  .new:hover {
    opacity: 1;
  }

  /* The conversation on screen. Not underlined — it is where you already are. */
  .rail :global(.entry[aria-current='page']) {
    opacity: 1;
  }

  /* Keyboard only. Without this, tabbing through the rail moves an invisible
     focus: the hover rule is the only thing that ever lit a row up. */
  .rail :global(.entry:focus-visible),
  .new:focus-visible {
    outline: 1px solid var(--white);
    outline-offset: 3px;
    opacity: 1;
  }

  .new {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    /* Left, not centred: as a stretched flex item in the desktop column a
       button centres its own label, which put "ny" in the middle of the rail
       while every title below it started at the edge. */
    text-align: left;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .shell {
      flex-direction: row;
      align-items: flex-start;
    }

    /* Stays put while the conversation scrolls past it. `max-height` rather
       than `height`, so a short list makes a short column and the moon below
       is not pushed off a mostly empty page. */
    .rail {
      position: sticky;
      top: 0;
      flex: 0 0 13rem;
      /* A flex item will not shrink below its content's min-content width, and
         `nowrap` titles make that the width of the longest one — so the basis
         above was ignored and the rail grew to fit a whole first sentence,
         taking the ellipsis with it. This is what makes 13rem mean 13rem. */
      min-width: 0;
      flex-direction: column;
      align-items: stretch;
      max-height: 100vh;
      margin-top: 0;
      /* Top padding clears the back arrow, and stays out of the scrolling
         area below — only .rail-list scrolls. */
      padding: 4.5rem 1.25rem 2rem 1.5rem;
      border-bottom: 0;
      border-right: 1px solid rgba(239, 237, 234, 0.12);
      overflow-x: visible;
    }

    /* The one thing that scrolls. `min-height: 0` is what lets a flex child
       shrink below its content and actually overflow. */
    .rail-list {
      display: block;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior-y: contain;
      scrollbar-width: thin;
    }

    /* One conversation per row. `display: block` is what stacks them; without
       it they are inline boxes that flow into each other. */
    .rail :global(.entry) {
      display: block;
      position: relative;
      /* Titles are as long as the first thing said; the column is not. */
      overflow: hidden;
      text-overflow: ellipsis;
      /* The left inset holds the marker below. Kept on every row, not just the
         current one, so the titles do not shift sideways as it moves. */
      padding: 0.3rem 0 0.3rem 0.85rem;
      font-size: 0.95rem;
    }

    /* Which one you are in. Opacity alone reads as "slightly less faded" in a
       list where the row above may be hovered; a mark is unambiguous. */
    .rail :global(.entry[aria-current='page']::before) {
      content: '';
      position: absolute;
      left: 0;
      top: 0.95em;
      width: 0.28rem;
      height: 0.28rem;
      border-radius: 50%;
      background: currentColor;
    }

    /* Lines up with the titles rather than sitting 0.85rem to their left. */
    .new {
      padding-left: 0.85rem;
    }

    .content {
      flex: 1;
      padding: 3vh 1.5rem 0;
    }

    .abbe {
      font-size: 1.05rem;
    }
  }

  /* ------------------------------------------------------------------ chat */

  .term {
    --me: #e2614f;
    --abbe: #7fa6ff;
  }

  .term h1 {
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .term h1 {
      margin-top: 4rem;
      font-size: 3rem;
    }
  }

  /* Transcript rows are built with createElement, so they never receive
     Astro's data-astro-cid-* scope attribute and a plain `.line {}` rule
     silently misses them. :global() matches them; anchoring to .term (which
     is in the template, so it *is* scoped) keeps it from leaking. */
  .term :global(.line) {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 1.25rem;
    align-items: start;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 768px) {
    .term :global(.line) {
      grid-template-columns: 5.5rem 1fr;
      gap: 0 1.5rem;
      margin-bottom: 1.3rem;
    }
  }

  /* Only the name is coloured — the message itself stays white. */
  .term :global(.line.me .who) {
    color: var(--me);
  }

  .term :global(.line.abbe .who) {
    color: var(--abbe);
  }

  .term :global(.line > span:last-child) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* A reply whose stream died before the model finished. Stored and shown
     rather than dropped, but marked, so it does not read as a whole thought. */
  .term :global(.line.partial > span:last-child::after) {
    content: ' …';
    opacity: 0.4;
  }

  /* A reply as it arrives: a block riding the last character. This is also what
     stands in for "(thinking)" before the first token lands — an empty line
     with a blinking cursor, which is the same thing a terminal does and needs
     no words. */
  .term :global(.line.streaming > span:last-child::after) {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.1em;
    background: var(--abbe);
    vertical-align: -0.15em;
    animation: blink 1s steps(1, end) infinite;
  }

  /* Joan ships Regular only, so the browser synthesises this weight. */
  .term :global(.who) {
    font-weight: 700;
  }

  /* The time, under the name. In the label column it costs no width from the
     message, which is what matters on a phone. */
  .term :global(.who .at) {
    display: block;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    opacity: 0.3;
  }

  .field {
    display: grid;
  }

  .mirror,
  .field textarea {
    grid-area: 1 / 1;
    font: inherit;
    line-height: inherit;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .mirror {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .field textarea {
    width: 100%;
    resize: none;
    overflow: hidden;
    background: none;
    /* Both transparent: the mirror above is the visible text and the caret. */
    color: transparent;
    caret-color: transparent;
  }

  .field textarea:focus {
    outline: none;
  }

  /* The mirror draws the selection. Left alone, the textarea paints its own
     highlight on top of text that is deliberately invisible, so a selection
     came out as a bar with nothing in it. */
  .field textarea::selection {
    background: transparent;
  }

  .sel {
    background: rgba(239, 237, 234, 0.22);
  }

  /* The rest of the command being typed. Dim enough to read as a suggestion
     rather than as something you already wrote. */
  .ghost {
    opacity: 0.28;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--white);
    vertical-align: -0.15em;
    animation: blink 1s steps(1, end) infinite;
  }

  /* `display: inline-block` above outranks the browser's [hidden] rule, so the
     block has to be hidden explicitly when a range is selected. */
  .cursor[hidden] {
    display: none;
  }

  .field:not(:focus-within) .cursor {
    animation: none;
    opacity: 0.3;
  }

  /* The prompt while a turn is in flight. Dimmed rather than emptied, and the
     textarea is only readOnly, so the caret stays exactly where it was. */
  .term form.busy {
    opacity: 0.45;
  }

  /* Aligned with the message column rather than the label column, so both read
     as remarks about the conversation and not as another speaker. */
  .status,
  .bar {
    margin: 0.25rem 0 0;
    padding-left: 6.25rem;
    opacity: 0.55;
  }

  .bar {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  /* Past ten seconds. Not an error — the opposite: it is the line saying it is
     still working, which is the moment you start to wonder. */
  .bar.slow {
    color: #d9a15b;
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .status,
    .bar {
      padding-left: 7rem;
    }
  }

  /* The system line under the heading: who is answering, how much history. */
  .boot {
    margin: -1.75rem 0 2.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    opacity: 0.3;
  }

  .boot:empty {
    display: none;
  }

  /* ---------------------------------------------------- the tool trace */

  /* Every call is written into the transcript; only .verbose shows them. That
     way turning it on reveals the calls behind replies already on screen
     instead of only applying to the next question. */
  .term :global(.trace) {
    display: none;
  }

  .term.verbose :global(.trace) {
    display: grid;
    grid-template-columns: 6.25rem auto 1fr;
    gap: 0 0.6rem;
    margin-bottom: 0.3rem;
    font-size: 0.8rem;
    opacity: 0.4;
  }

  /* The name sits in the label column, where a speaker's name would — these
     are the closest thing the vault has to a speaking part. */
  .term :global(.trace .tname) {
    text-align: right;
  }

  .term :global(.trace .tdetail) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term :global(.trace .tms) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .term :global(.trace.failed) {
    color: var(--me);
  }

  @media (min-width: 768px) {
    .term.verbose :global(.trace) {
      grid-template-columns: 7rem auto 1fr;
    }
  }

  /* ------------------------------------------ the terminal's own output */

  /* Help, search results, notices. A grid rather than padded text: the site's
     face is proportional, so columns cannot be faked with spaces. */
  .term :global(.sys) {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    gap: 0.15rem 0.6rem;
    margin: 0 0 1.3rem;
    font-size: 0.9rem;
  }

  .term :global(.sys .sysh) {
    grid-column: 1 / -1;
    margin-bottom: 0.35rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.35;
  }

  .term :global(.sys .sysk) {
    text-align: right;
    opacity: 0.5;
  }

  .term :global(.sys .sysv) {
    opacity: 0.8;
  }

  .term :global(.sys a) {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .term :global(.sys) {
      grid-template-columns: 7rem 1fr;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .term :global(.line.streaming > span:last-child::after) {
      animation: none;
    }
  }
</style>
