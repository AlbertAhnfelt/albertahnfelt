---
import Layout from '../layouts/Layout.astro'
import BackArrow from '../components/BackArrow.astro'
import MoonCorner from '../components/MoonCorner.astro'
import NotFound from '../components/NotFound.astro'
import Terminal from '../components/abbe/Terminal.svelte'

// The Abbe interface — the shell only. Everything that is actually the chat
// lives in Terminal.svelte, mounted client:only, so none of it is in the static
// HTML: not a conversation, not a title, not the heading, not the prompt. What
// this file ships to an anonymous visitor is the site's ordinary 404 and
// nothing else — no notice, no login link, nothing that names Abbe.
//
// That is presentation. Every real check lives in the Worker, which
// re-validates the session cookie against the allowlist on every request.
// Signing in is done by going straight to /api/abbe/web/login?returnTo=/abbe.
//
// One page serves both a new conversation and an existing one; which is decided
// from location.pathname inside the island. /abbe/:id is rewritten here by
// vercel.json (and by the dev middleware in astro.config.mjs), because a
// conversation id cannot be prerendered — knowing them at build time would mean
// knowing the history.
---

<!-- Titled 404, not Abbe: the static HTML every visitor gets should read as the
     404 it will be for almost all of them. `authTitle` is the tab's other name,
     applied only once the session is believed to be real. -->
<Layout title="404" authTitle="Abbe">
  <div data-abbe>
    <!-- Both states are switched by CSS, keyed off the flag Layout's head
         script stamps on <html> before the first paint. Neither shows until
         that flag is set, so there is no frame with both and none where the
         page sits empty waiting on the network. -->
    <div data-state="out">
      <NotFound persist={false} />
    </div>

    <main data-state="in">
      <BackArrow href="/" label="Till startsidan" variant="corner" />

      <!-- client:only, not client:load: there is nothing here to prerender, and
           rendering it on the server would put the chrome of a private surface
           into a document served to everyone. The island decides the session
           for itself and flips the flag above. -->
      <Terminal client:only="svelte" />

      <MoonCorner variant="bottom-center" />
    </main>
  </div>
</Layout>

<style>
  /* Neither state shows until <html> has been told which one is real, so a
     browser with JavaScript off sees the same nothing it saw when both blocks
     were `hidden`. :global() on the <html> half because Astro's scoping would
     otherwise demand this component's attribute on the root element, which
     never has it. */
  [data-state] {
    display: none;
  }

  :global(html[data-session='out']) [data-state='out'] {
    display: block;
  }

  /* Flex column so the moon's `margin-top: auto` can push it to the bottom of a
     short page, and get pushed down by a long conversation instead. */
  :global(html[data-session='in']) [data-state='in'] {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
