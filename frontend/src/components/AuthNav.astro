---
// The site is statically built, so nothing here can be rendered per-visitor:
// both links ship in every copy of the HTML and CSS reveals exactly one, keyed
// off the flag Layout's head script stamps on <html> from the hint cookie. That
// happens before the first paint, so the menu never arrives a link short.
//
// This is presentation only. /abbe is public HTML like every other page — the
// real gate is the session cookie the Worker checks on anything that returns
// actual vault content.
---

<span class="auth-nav" data-auth-nav>
  <a class="auth-link" href="/abbe" data-auth="in">abbe</a>
  <a class="auth-link" href="/api/abbe/web/login?returnTo=/abbe" data-auth="out">logga in</a>
</span>

<script>
  const resolve = async (root: HTMLElement) => {
    // Each render gets one pass; a client-side navigation brings a fresh,
    // unmarked element.
    if (root.dataset.ready) return
    root.dataset.ready = '1'

    // Revalidation, not revelation: the right link is already on screen. This
    // only matters when the hint is stale — a session revoked or expired since
    // the last load — and it is off the critical path either way.
    try {
      const res = await fetch('/api/abbe/web/me', { headers: { accept: 'application/json' } })
      document.documentElement.dataset.session = res.ok ? 'in' : 'out'
    } catch {
      // Offline, or the Worker is down. Leave the optimistic paint alone.
    }
  }

  const run = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-auth-nav]')) resolve(root)
  }

  run()
  document.addEventListener('astro:page-load', run)
</script>

<style>
  /* Let the two links sit in the parent menu's flex flow as if the wrapper
     weren't here. */
  .auth-nav {
    display: contents;
  }

  /* Two classes, because .menu a is a class and a type and would otherwise win
     and show both links at once. */
  .auth-nav .auth-link {
    display: none;
  }

  /* :global() on the <html> half: Astro's scoping would otherwise want this
     component's attribute on the root element, which never has it. */
  :global(html[data-session='in']) .auth-link[data-auth='in'],
  :global(html[data-session='out']) .auth-link[data-auth='out'] {
    display: inline-block;
  }
</style>
